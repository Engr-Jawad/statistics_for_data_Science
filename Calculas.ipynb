   "source": [
    "x = np.linspace(10,100,1000000)\n",
    "y = np.sqrt(x)\n",
    "plt.figure(figsize = (8,9))\n",
    "plt.plot(x,y,label=\" Y = /x\")\n",
    "plt.title(\"Root of x\")\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"y\")\n",
    "plt.grid()\n",
    "plt.legend()\n",
    "plt.show()"
   ]
